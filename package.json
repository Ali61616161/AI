    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locales.js",
    "db:test": "scripts/test-db.sh",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts && prettier --single-quote --print-width 110 --write src/types/database.ts",
    "preview:web": "EXPO_WEB_OUTPUT=single expo export --clear --platform web --output-dir dist-preview && node scripts/build-web-preview.mjs dist-preview dist-preview/yola-preview.html",
    "functions:check": "cd supabase/functions && deno check */index.ts && deno lint && cd ../.. && deno check --config supabase/functions/deno.json scripts/local-stack/functions-router.ts",
    "functions:test": "deno test --config supabase/functions/deno.json supabase/functions src/features",
    "db:types:local": "scripts/gen-db-types-local.sh",
    "e2e:local": "node tests/e2e/replan.e2e.mjs && node tests/e2e/places.e2e.mjs && node tests/e2e/translate.e2e.mjs && node tests/e2e/tools.e2e.mjs && node tests/e2e/report.e2e.mjs && node tests/e2e/subscription.e2e.mjs && node tests/e2e/social.e2e.mjs"
  },
  "private": true
}
